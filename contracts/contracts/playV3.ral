// Chain Reaction Game Contract
// Players join a chain by paying entry + 10% more than previous
// If no one joins within timeout blocks, last player wins pot

Contract ChainReactionV3(
    factoryId: ByteVec,
    durationDecreaseMs: U256,
    minDuration: U256,
    addrFees: Address,
    isFixedTokenId: Bool,
    mut chainId: U256,
    mut currentEntry: U256,        // Current entry price
    mut lastPlayer: Address,       // Last player who joined
    mut lastEntryTimestamp: U256,     // Block when last player joined
    mut pot: U256,                 // Total pot
    mut boostAmount: U256,
    mut playerCount: U256,         // Number of players in current chain
    mut isActive: Bool,            // Is chain active?
    mut baseEntry: U256,               // Starting entry (1 ALPH)
    mut endTimestamp: U256,
    mut durationMs: U256,
    mut multiplierBps: U256,        // Multiplier in basis points (1000 = 10%)
    mut tokenId: ByteVec,
    mut burnBps: U256,
    mut burnedAmount: U256,
    mut feesBps: U256,
    mut decayPeriodMs: U256         // Time in ms for price to decay back to baseEntry (0 = no decay)
) {

    // Events
    event ChainStarted(chainId: U256, startBlock: U256, feesBps: U256, tokenId: ByteVec)
    event PlayerJoined(chainId: U256, player: Address, entryFee: U256, newPot: U256, position: U256, amountBurned: U256, tokenId: ByteVec)
    event ChainEnded(chainId: U256, winner: Address, payout: U256, totalBurned: U256, feesAmount: U256)
    event ChainTimeout(chainId: U256, player: Address)
    event PotBoosted(caller: Address, amount: U256)

    enum ErrorCodes {
        ChainNotActive = 0
        InsufficientPayment = 2
        ChainAlreadyActive = 3
        TooEarlyToEnd = 4
        GameEnded = 5
        DurationToLow = 6
        BurnRateTooHigh = 7
        FeesToHigh = 8
        TokenIdIncorrect = 9
        DecayPeriodTooLong = 10
    }

    // Start a new chain
    @using(preapprovedAssets = true, updateFields = true, checkExternalCaller = false, assetsInContract = true)
    pub fn startChain(callerAddr: Address, payment: U256, durationGameMs: U256, multiplierGameBps: U256, tokenIdGame: ByteVec, burnRate: U256, feesBpsGame: U256, decayPeriodMsGame: U256) -> (U256, U256, U256, U256) {
        // Check no active chain
        assert!(!isActive, ErrorCodes.ChainAlreadyActive)
        assert!(durationGameMs >= durationDecreaseMs, ErrorCodes.DurationToLow)
        assert!(burnRate <= 10000, ErrorCodes.BurnRateTooHigh)
        assert!(feesBpsGame <= 10000, ErrorCodes.FeesToHigh)
        assert!(!isFixedTokenId || tokenIdGame == tokenId, ErrorCodes.TokenIdIncorrect)
        assert!(decayPeriodMsGame <= durationGameMs, ErrorCodes.DecayPeriodTooLong)

        let timestamp = blockTimeStamp!()
        
        // Require base entry payment
        assert!(payment > 0, ErrorCodes.InsufficientPayment)
        let  mut caller = callerAddress!()
        if caller == contractIdToAddress!(factoryId) {
            caller = callerAddr
        }
        transferTokenToSelf!(caller, tokenIdGame, payment)


        // Initialize new chain
        baseEntry = payment
        tokenId = tokenIdGame
        durationMs = durationGameMs
        multiplierBps = multiplierGameBps
        feesBps = feesBpsGame
        chainId = chainId + 1
        currentEntry = baseEntry
        lastPlayer = caller
        endTimestamp = timestamp + durationMs
        lastEntryTimestamp = timestamp
        pot = pot + payment
        playerCount = 1
        burnBps = burnRate
        burnedAmount = 0
        decayPeriodMs = decayPeriodMsGame
        isActive = true

        emit ChainStarted(chainId, lastEntryTimestamp, feesBps, tokenId)
        emit PlayerJoined(chainId, lastPlayer, payment, pot, playerCount, 0, tokenId)

        return chainId, lastEntryTimestamp, pot, playerCount
    }

    // Join existing chain
    @using(preapprovedAssets = true, updateFields = true, checkExternalCaller = false, assetsInContract = true)
    pub fn joinChain(callerAddr: Address, payment: U256) -> (U256, U256, U256, U256, U256) {
        // Verify chain is active
        assert!(isActive, ErrorCodes.ChainNotActive)
        let mut caller = callerAddress!()
        if caller == contractIdToAddress!(factoryId) {
            caller = callerAddr
        }
        
        // Check max players not reached
        //assert!(playerCount < maxPlayers, ErrorCodes.ChainFull)
        let timestamp = blockTimeStamp!()
        assert!(timestamp < endTimestamp, ErrorCodes.GameEnded)

        // Calculate required entry (previous + 10%)
        let requiredEntry = getNextEntryPrice()
        assert!(payment >= requiredEntry, ErrorCodes.InsufficientPayment)

        transferTokenToSelf!(caller, tokenId, requiredEntry)

        // Update state
        playerCount = playerCount + 1
        currentEntry = requiredEntry
        lastPlayer = caller
        lastEntryTimestamp = timestamp

        let amountToBurn = requiredEntry * burnBps / 10000
        burnedAmount = burnedAmount + amountToBurn

        let totalPayment = requiredEntry - amountToBurn
        if tokenId != ALPH {
            burnToken!(selfAddress!(), tokenId, amountToBurn)
        }

        let mut totalDurationDecrease = durationMs
        // set the smallest duration timer to 1m
        if totalDurationDecrease <= minDuration {
            totalDurationDecrease = minDuration
        } else {
            totalDurationDecrease = durationMs - (playerCount * durationDecreaseMs) 
        }

        endTimestamp = timestamp + totalDurationDecrease
        pot = pot + totalPayment

        emit PlayerJoined(chainId, lastPlayer, totalPayment, pot, playerCount, amountToBurn, tokenId)

        return chainId, totalPayment, pot, playerCount, amountToBurn
    }

    // End chain and pay winner (callable by anyone after timeout)
    @using(assetsInContract = true, updateFields = true, checkExternalCaller = false)
    pub fn endChain() -> (U256, Address, U256, U256, U256) {

        assert!(canEnd(), ErrorCodes.TooEarlyToEnd)

        let feesAmount = pot * feesBps / 10000
        let totalAmount = boostAmount + (pot-feesAmount) //incentive not taken in consideration for fees
    

        // Pay winner
        transferTokenFromSelf!(lastPlayer, tokenId, totalAmount)

        if addrFees != nullContractAddress!() && feesAmount > 0 {
            transferTokenFromSelf!(addrFees, tokenId, feesAmount)
        }

        emit ChainEnded(chainId, lastPlayer, totalAmount, burnedAmount, feesAmount)

        let burnedAmountRound = burnedAmount
        let totalAmountRound = totalAmount
        let chainIdRound = chainId

        // Reset for next chain
        isActive = false
        pot = 0
        boostAmount = 0
        playerCount = 0
        currentEntry = 0
        burnedAmount = 0

        return chainIdRound, lastPlayer, totalAmountRound, burnedAmountRound, feesAmount
  
    }

    // Check if chain can be ended (view function)
    pub fn canEnd() -> Bool {
        if (!isActive) {
            return false
        }

        return blockTimeStamp!() >= endTimestamp
    }

    // Get current chain info (view function)
    pub fn getChainInfo() -> (U256, U256, Address, U256, U256, Bool, U256) {
        return (chainId, currentEntry, lastPlayer, lastEntryTimestamp, pot, isActive, playerCount)
    }

    @using(preapprovedAssets = true, updateFields = true, checkExternalCaller = false, assetsInContract = true)
    pub fn incentive(callerAddr: Address, amount: U256) -> () {
        assert!(isActive, ErrorCodes.ChainNotActive)

        let  mut caller = callerAddress!()
        if caller == contractIdToAddress!(factoryId) {
            caller = callerAddr
        }

        transferTokenToSelf!(caller, tokenId, amount)
        boostAmount = boostAmount + amount

        emit PotBoosted(caller, amount)
    }

    // Calculate next entry price with optional time-based decay
    pub fn getNextEntryPrice() -> U256 {
        if (!isActive) {
            return baseEntry
        }

        let mut effectiveEntry = currentEntry

        // Apply time-based decay toward baseEntry
        if decayPeriodMs > 0 && currentEntry > baseEntry {
            let elapsed = blockTimeStamp!() - lastEntryTimestamp
            let excess = currentEntry - baseEntry
            if elapsed >= decayPeriodMs {
                effectiveEntry = baseEntry
            } else {
                effectiveEntry = currentEntry - (excess * elapsed / decayPeriodMs)
            }
        }

        return effectiveEntry + (effectiveEntry * multiplierBps / 10000)
    }

    pub fn getFactoryId() -> ByteVec {
        return factoryId
    }


}
